# .claude/swarm.env — this repo's profile for the shared DV swarm kit (markrthomas/dv-swarm-kit).
# See the kit's templates/swarm.env.example for what each key means. Environment variables override these.

PROJECT=ip-ucie-rdi-to-pcie-pipe
GH_REPO=markrthomas/ip-ucie-rdi-to-pcie-pipe
DUT_TOP=ucie_rdi_to_pcie_pipe_bridge

RTL_DIR=src
TB_DIR=test

DV_ENVS="verilator uvm"
GATE_TARGET=quick
CI_TARGET=ci
CROSSCHECK_TARGET=
INFRA_TARGETS="formal docs-check"
HEAVY_TARGETS="regress-all regress-cov uvm formal ci"

MUTATION_FILE=src/ucie_rdi_to_pcie_pipe_bridge.sv
MUTATION_HINT="invert one valid/ready qualifier or corrupt one data bit on the main datapath"

RR_DIR=test/random
RR_STATUS=bootstrap

METRICS=no
